<% layout('layouts/boilerplate') %>

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1>Industry Skill Demand</h1>

        <p class="text-muted">Labour-market demand for skills</p>
    </div>


    <% skillData.forEach(data => { %>
        <div class="card">
            <div class="card-body shadow-sm mb-4">
                <h3 class="card-title"><%= data.course %></h3>

                <p class="text-muted"><%= data.district %> | <%= data.sector %></p>

                <h5 class="mt-4">
                    Industry Demand
                </h5>

                <div class="row mt-3">
                    <!-- <% if (data.industryDemand && typeof data.industryDemand === 'object') { %> -->
                        <% for (const [skill, demand] of Object.entries(data.industryDemand)) { %>
                            <div class="col-md-4 mb-3">
                                <div class="card">
                                    <div class="card-body">
                                        <h6><%= skill %></h6>

                                        <div class="progress">
                                            <div class="progress-bar" role="progressbar" style="width: <%= demand %>%"><%= demand %>%</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    <!-- <% } %> -->
                </div>
            </div>
        </div>
    <% }) %>
</div>