<% layout('layouts/boilerplate') %>

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1>Employer Validations</h1>

         <p class="text-muted">Industry feedback on required skills.</p>
    </div>

    <% if(feedbacks.length == 0) { %>
        <div class="alert alert-info">No employer validations submitted yet.</div>
    <%}%>

    <% feedbacks.forEach(feedback => { %>
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h4><%= feedback.company %></h4>

                <p class="text-muted">Role : <%= feedback.role %></p>

                <h6>Required Skills</h6>

                <div class="mb-3">
                    <% feedback.skills.forEach(item => { %>
                        <span class="badge bg-primary me-2"><%= item.skill %></span>
                    <% }) %>
                </div>

                <% if(feedback.feedback) { %>
                    <div class="alert alert-light">
                        <strong>Employer Feedback:</strong>
                        <p class="mb-0 mt-2"><%= feedback.feedback %></p>
                    </div>
                <%}%>

                <small class="text-muted"> Submitted : <%= feedback.createdAt.toLocaleDateString() %></small>
            </div>
        </div>
    <% }) %>
</div>