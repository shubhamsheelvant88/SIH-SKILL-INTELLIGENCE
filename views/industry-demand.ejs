<% layout('layouts/boilerplate') %>


<div class="container mt-5">
    <div class="text-center mb-5">
        <h1>Industry Skill Demand</h1>

        <p class="text-muted">Automatically calculated from submitted job postings</p>
    </div>

    <div class="alert alert-info">
        Total Job Postings Analyzed :
        <strong><%= totalJobs %></strong>
    </div>


    <% if(Object.keys(industryDemand).length === 0) { %>
        <div class="alert alert-warning">
            No job postings available for analysis.
        </div>
    <% } else { %>
        <div class="row">
            <% Object.entries(industryDemand).sort((a, b) => b[1] - a[1]).forEach(([skill, demand]) => { %>
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5><%= skill %></h5>

                            <h3><%= demand %></h3>

                            <div class="progress">
                                <div class="progress-bar" role="progressbar" style="width: <%= demand %>%"><%= demand %>%</div>
                            </div>
                            
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>