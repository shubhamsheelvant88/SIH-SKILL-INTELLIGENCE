<% layout('layouts/boilerplate') %>

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1>Analyzed Job Postings</h1>

         <p class="text-muted">Skills extracted from submitted job postings</p>
    </div>

    <% if(jobs.length == 0) { %>
        <div class="alert alert-info"> No job postings analyzed yet.</div>
    <%}%>

    <% jobs.forEach(job => { %>
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h3><%= job.role %></h3>

                <p class="text-muted"><%= job.company %> | <%= job.location %></p>

                <h6>Extracted Skills</h6>

                <div class="mb-3">
                    <% job.extractedSkills.forEach(skill => { %>
                        <span class="badge bg-primary me-2 mb-2"><%= skill %></span>
                    <% }) %>
                </div>

                <hr>

                <h6>Job Description</h6>

                <p><%= job.description %></p>

                <small class="text-muted"> Submitted : <%= job.createdAt.toLocaleDateString() %></small>
            </div>
        </div>
    <% }) %>
</div>