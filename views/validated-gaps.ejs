<% layout('layouts/boilerplate') %>


<div class="conatiner mt-5">
    <div class="text-center mb-5">
        <h1>Validated Skill Gaps</h1>

        <div class="text-muted">Skill gaps validated against employer requirements</div>
    </div>

    <% results.forEach(result => { %>
        <div class="card shadow-sm mb-5">
            <div class="card-body">
                <h3><%= result.data.course %></h3>

                <p class="text-muted"><%=result.data.district %> | <%= result.data.sector %></p>

                <% if(result.validatedGaps.length == 0) { %>
                    <div class="alert alert-success">No skill gaps detected.</div>
                <% } else {%>
                    <% result.validatedGaps.forEach(gap => { %>
                        <div class="card mb-4">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <h4><%= gap.skill %></h4>

                                    <% if(gap.priority === "High") { %>
                                        <span class="badge bg-danger">High Priority</span>
                                    <%} else if(gap.priority === "Medium") {%>
                                        <span class="badge bg-warning text-dark">Medium Priority</span>
                                    <%} else {%>
                                        <span class="badge bg-secondary">Low Priority</span>
                                    <%}%>
                                </div>

                                <div class="row mt-4">
                                    <div class="col-md-6">
                                        <h6>Industry Demand</h6>

                                        <h3><%= gap.demand %>%</h3>

                                        <div class="progress">
                                            <div class="progress-bar" style="width: <%= gap.demand %>%"><%= gap.demand %>%</div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                         <h6>Employer Validation</h6>

                                          <h3><%= gap.validationPercentage %>%</h3>

                                          <p class="text-muted">Validated By <strong><%= gap.validatedBy %></strong> of <strong><%= gap.totalEmployers %></strong></p>

                                          <div class="progress">

                                            <div class="progress-bar bg-success"style="width: <%= gap.validationPercentage %>%"><%= gap.validationPercentage %>%</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="alert alert-light mt-4">
                                    <strong>Platform Insight:</strong>

                                    <p class="mb-0 mt-2"><%= gap.skill %> is required by <%= gap.validationPercentage %>% of submitted employers and has <%= gap.demand %>% industry demand.</p>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <%}%>
            </div>
        </div>
    <% }) %>
</div>