<% layout('layouts/boilerplate') %>

<div class="cotainer mt-5">
    <div class="text-center mb-5">
        <h1>Skill Gap Analysis</h1>

         <p class="text-muted">Comparing industry requirements with the current curriculum.</p>
    </div>

    <% results.forEach(result => { %>
        <div class="card shadow-sm mb-5">
            <div class="card-body">
                <h3><%= result.data.course %></h3>

                <p><%= result.data.district %> | <%= result.data.sector %></p>

                <h4 class="mt-4 mb-3">Missing Skills</h4>


                <% if(result.gaps.length == 0) { %>
                    <div class="alert alert-success"> No major skill gaps detected.</div>
                <% } else {%>
                    <div class="row">
                        <% result.gaps.forEach(gap => { %>
                            <div class="col-md-6 mb-3">
                                <div class="card border">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between">
                                            <h5><%= gap.skill %></h5>

                                            <% if(gap.priority === "High") { %>
                                                <span class="badge bg-danger">High</span>
                                            <% } else if(gap.priority === "Medium"){ %>
                                                <span class="badge bg-warning text-dark">Medium</span>
                                            <% } else { %>
                                                <span class="badge bg-secondary">Low</span>
                                            <% } %>
                                        </div>

                                        <p class="mt-3 mb-2">Industry Demand : <strong> <%= gap.demand %>%</strong></p>

                                        <div class="progress">

                                            <div class="progress-bar" role="progressbar" style="width: <%= gap.demand %>%">
                                                <%= gap.demand %>%
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        </div>
    <% }) %>
</div>