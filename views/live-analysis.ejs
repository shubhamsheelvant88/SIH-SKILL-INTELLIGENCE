<% layout('layouts/boilerplate') %>

<div class="cotainer mt-5">
    <div class="text-center mb-5">
        <h1>Live Labour Market Analysis</h1>

         <p class="text-muted">Industry demand generated from job postings</p>
    </div>

    <!-- JOB INFORMATION -->

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h3><%= data.course %></h3>

            <p><%= data.district %> | <%= data.sector %></p>

            <h5>Total Job Postings : <%= totalJobs %></h5>
        </div>
    </div>

    <!-- INDUSRTY DEMAND FROM JOB POSTING-->
     <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h3>Industry Skill Demand</h3>

            <div class="row mt-4">
                <% for(let skill in industryDemand) { %>
                    <div class="col-md-4 mb-3">
                        <div class="card">
                            <div class="card-body">
                                <h5><%= skill %></h5>

                                <div class="progress">
                                    <div class="progress-bar" role="progressbar" style="width: <%= industryDemand[skill] %>%"><%= industryDemand[skill] %>%</div>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
     </div>

    <!-- SKILL GAPS FROM CURRICULUM-->
    <div class="card shadow-sm">
        <div class="card-body">
            <h3>Detected Skill Gaps</h3>

            <% if(gaps.length == 0) { %>
                <div class="alert alert-success mt-3">
                    No skill gaps detected.
                </div>
            <%} else {%>
                <div class="row mt-4">
                    <% gaps.forEach(gap => { %>
                        <div class="col-md-4 mb-3">
                            <div class="card">
                                <div class="card-body">
                                    <h5><%= gap.skill %></h5>

                                    <p>Industry Demand : <strong><%= gap.demand %>%</strong></p>

                                    <span class="badge bg-danger"><%= gap.priority %> Priority</span>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <%}%>
        </div>
    </div>
</div>