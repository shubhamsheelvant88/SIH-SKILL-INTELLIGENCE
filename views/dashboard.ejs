<% layout('layouts/boilerplate') %>

<div class="container mt-5">
    <div class="text-center mb-5">

        <h1 class="display-5 fw-bold">
            Skill Intelligence Dashboard
        </h1>

        <p class="text-muted lead">Industry demand analysis and training intelligence</p>
    </div>

    <% skillData.forEach(data => { %>
        <!-- location & sector -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <h6>District : </h6>
                        <h4><%= data.district %></h4>
                    </div>
                    <div class="col-md-4">
                        <h6>Sector : </h6>
                        <h4><%= data.sector %></h4>
                    </div>
                    <div class="col md-4">
                        <h6>Course : </h6>
                        <h4><%= data.course %></h4>
                    </div>
                </div>
            </div>
        </div>
        <!-- Summary cards -->
         <div class="row g-4 mb-3">
            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h6>SKILLS ANALYSED</h6>
                         <h2> <%=  Object.keys(data.industryDemand).length %> </h2>
                        <p class="text-muted mb-0">Industry skills</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h6>CURRICULUM SKILLS</h6>
                        <h2> <%= data.currentCurriculum.length %> </h2>
                        <p class="text-muted mb-0">Currently taught</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h6>SKILLS GAPS</h6>
                         <h2> <%= Object.keys(data.industryDemand).length - data.currentCurriculum.length %> </h2>
                        <p class="text-muted mb-0">Skills missing</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h6>TOP DEMAND</h6>
                        <h2> 85% </h2>
                        <p class="text-muted mb-0">Highest skill demand</p>
                    </div>
                </div>
            </div>
         </div>

        <!-- Main Actions -->
         <div class="row g-4">
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h4>📊 Industry Demand</h4>
                        <p class="text-muted">Analyze the skills currently demanded by the industry.</p>
                         <a href="/skills" class="btn btn-primary"> View Skill Demand</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h4> 🎯 Skill Gap</h4>
                        <p class="text-muted">Identify skills demanded by industry but missing from the curriculum.</p>
                         <a href="/skill-gap" class="btn btn-warning">Analyse Skill Gap</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h4>💡 Recommendations</h4>
                        <p class="text-muted">Get curriculum and training recommendations.</p>
                         <a href="/recommendations" class="btn btn-primary">View Recommendations</a>
                    </div>
                </div>
            </div>
         </div>
    <% }) %>
</div>