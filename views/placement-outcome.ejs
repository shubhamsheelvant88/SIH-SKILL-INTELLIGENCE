<% layout('layouts/boilerplate') %>

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1>Placement Outcome</h1>

         <p class="text-muted">Record training and placement results</p>
    </div>

    <form action="placement-outcome" method="POST">
        <div class="mb-3">
            <label class="form-label">District</label>
            <input type="text" name="district" class="form-control" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Course</label>
            <input type="text" name="course" class="form-control" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Students Trained</label>
            <input type="text" name="studentsTrained" class="form-control" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Students Completed</label>
            <input type="text" name="studentsCompleted" class="form-control" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Students Placed</label>
            <input type="text" name="studentsPlaced" class="form-control" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Average Salary</label>
            <input type="text" name="averageSalary" class="form-control">
        </div>

        <div class="mb-3">
            <label class="form-label">
                Skills Used in Jobs
            </label>
            <input type="text" name="skillsUsed" class="form-control" placeholder="React, AWS, Node.js">
        </div>

        <div class="mb-3">

            <label class="form-label">
                Employer Satisfaction (1-5)
            </label>
            <input type="number" name="employerSatisfaction" min="1" max="5" class="form-control">
        </div>

        <button class="btn btn-primary">
            Submit Placement Outcome
        </button>
    </form>
</div>