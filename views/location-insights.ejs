<% layout('layouts/boilerplate') %>

<div class="container mt-5 mb-5">
    <div class="text-center mb-4">
        <h1>Location Job Intelligence</h1>
        <p class="text-muted">Find trending roles and the skills needed to prepare for them.</p>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form action="/location-insights" method="POST" class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label for="location" class="form-label">City or district</label>
                    <input id="location" name="location" class="form-control" value="<%= location %>" placeholder="e.g. Bengaluru" required>
                </div>
                <div class="col-md-4">
                    <label for="role" class="form-label">Specific role (optional)</label>
                    <input id="role" name="role" class="form-control" value="<%= selectedRole %>" placeholder="e.g. Full Stack Developer">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Analyze</button>
                </div>
            </form>
        </div>
    </div>

    <% if (insights) { %>
        <% if (!insights.hasLocationData) { %>
            <div class="alert alert-info">
                No job postings were found for <strong><%= insights.location %></strong>.
                Add postings with this location and analyze again.
            </div>
        <% } else { %>
            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <div class="card shadow-sm h-100"><div class="card-body">
                        <h6>LOCATION</h6>
                        <h3><%= insights.location %></h3>
                    </div></div>
                </div>
                <div class="col-md-4">
                    <div class="card shadow-sm h-100"><div class="card-body">
                        <h6>POSTINGS ANALYZED</h6>
                        <h3><%= insights.roleJobsCount %></h3>
                        <% if (insights.selectedRole) { %><p class="text-muted mb-0"><%= insights.selectedRole %></p><% } %>
                    </div></div>
                </div>
                <div class="col-md-4">
                    <div class="card shadow-sm h-100"><div class="card-body">
                        <h6>TRENDING ROLES</h6>
                        <h3><%= insights.trendingRoles.length %></h3>
                    </div></div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h2 class="h4">Trending jobs</h2>
                    <p class="text-muted">Roles ranked by the number of postings in this location.</p>
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead><tr><th>Role</th><th>Postings</th><th>Share of local postings</th><th></th></tr></thead>
                            <tbody>
                                <% insights.trendingRoles.forEach(item => { %>
                                    <tr>
                                        <td><strong><%= item.role %></strong></td>
                                        <td><%= item.count %></td>
                                        <td><%= item.demandPercentage %>%</td>
                                        <td>
                                            <form action="/location-insights" method="POST">
                                                <input type="hidden" name="location" value="<%= insights.location %>">
                                                <input type="hidden" name="role" value="<%= item.role %>">
                                                <button class="btn btn-sm btn-outline-primary" type="submit">View plan</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h2 class="h4">Required skills</h2>
                    <p class="text-muted">Skills found in <%= insights.roleJobsCount %> matching posting(s).</p>
                    <div class="row g-3">
                        <% insights.skills.forEach(item => { %>
                            <div class="col-md-4">
                                <div class="border rounded p-3">
                                    <strong><%= item.skill %></strong>
                                    <div class="text-muted"><%= item.demandPercentage %>% of postings</div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>

            <% if (insights.recommendedCourse) { %>
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h2 class="h4">Recommended course</h2>
                        <h3 class="h5"><%= insights.recommendedCourse.course %></h3>
                        <p>Skill coverage: <strong><%= insights.recommendedCourse.coveragePercentage %>%</strong></p>
                        <p class="mb-1"><strong>Skills already covered</strong></p>
                        <p class="text-muted"><%= insights.recommendedCourse.coveredSkills.join(", ") || "None" %></p>
                        <p class="mb-1"><strong>Skills to add</strong></p>
                        <p class="text-muted"><%= insights.recommendedCourse.missingSkills.join(", ") || "No additional skills identified" %></p>
                    </div>
                </div>
            <% } %>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h2 class="h4">Suggested study plan</h2>
                    <% if (insights.studyPlan.length === 0) { %>
                        <p class="text-success mb-0">The selected course already covers the detected skills.</p>
                    <% } else { %>
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead><tr><th>Phase</th><th>Skill</th><th>Duration</th><th>Topics</th><th>Practice project</th></tr></thead>
                                <tbody>
                                    <% insights.studyPlan.forEach(item => { %>
                                        <tr>
                                            <td><%= item.phase %></td>
                                            <td><strong><%= item.skill %></strong></td>
                                            <td><%= item.durationWeeks %> week(s)</td>
                                            <td><%= item.topics.join(", ") %></td>
                                            <td><%= item.project %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </div>
            </div>
        <% } %>
    <% } %>
</div>