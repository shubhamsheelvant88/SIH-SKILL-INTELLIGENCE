<% layout('layouts/boilerplate') %>

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1>Emloyer Validation</h1>

        <p class="text-muted">Employers can validate the skills required in the industry</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form action="/employer-feedback" method="POST">
                <div class="mb-3">
                    <label class="form-label">Company Name</label>
                    <input type="text" name="company" class="form-control" placeholder="Enter company name" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Job Role</label>
                    <input type="text" name="role" class="form-control" placeholder="e.g. Full Stack Developer" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Skills Required</label>
                    <input type="text" name="skills" class="form-control" placeholder="React, Node.js, AWS" required>

                    <small class="text-muted">Separate skills using commas.</small>
                </div>

                <div class="mb-3">
                    <label class="feedback">Feedback</label>
                    <textarea name="feedback" class="form-control" row="4" placeholder="Enter your feedback about candidate skills..."></textarea>
                </div>

                <button type="submit" class="btn btn-primary">Submit Validation</button>
            </form>
        </div>
    </div>
</div>