<% layout('layouts/boilerplate') %>

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1>Curriculum Reccomendations</h1>

        <p class="text-muted"> Recommended curriculum updates based on industry demand</p>
    </div>

    <% results.forEach(result => { %>
        <div class="card shadow-sm mb-5">
            <div class="card-body">
                <h3><%= result.data.course %></h3>

                <p><%= result.data.district %> | <%= result.data.sector %></p>

                <% if(result.recommendations.length == 0) { %>
                    <div class="alert alert-success">No curriculum updates are currently required.</div>
                <%} else { %>
                    <% result.recommendations.forEach(rec => { %>
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <h5><%= rec.skill %></h5>

                                    <% if(rec.priority == "High") { %>
                                        <span class="badge bg-danger">High Priority</span>
                                    <% } else if(rec.priority == "Medium") {%>
                                        <span class="badge bg-warning text-dark">Medium Priority</span>
                                    <%} else {%>
                                        <span class="badge bg-secondary">Low Priority</span>
                                    <%}%>
                                </div>
                                <p class="mt-3">Industry Demand : <strong><%= rec.demand %>%</strong></p>

                                <div class="progress mb-3">
                                    <div class="progress-bar" role="progressbar" style="width: <%= rec.demand %>%"><%= rec.demand %>%
                                    </div>
                                </div>

                                <div class="alert alert-light">
                                    <strong>Recommended upadate : </strong>

                                    <p class="mb-0 mt-2"><%= rec.recommendation %></p>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <%}%>
            </div>
        </div>
    <% }) %>
</div>