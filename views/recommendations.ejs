<% layout('layouts/boilerplate') %>

<div class="container-fluid px-0">

    <!-- ===== PAGE HEADER ===== -->
    <div class="page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="mb-1">
                <i class="bi bi-journal-check text-primary me-2"></i>Curriculum Recommendations
            </h1>
            <p class="text-muted mb-0">
                Actionable learning paths and curriculum enhancements based directly on your skill gap analysis.
            </p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a href="/skill-gap" class="btn btn-outline-primary d-inline-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle"></i>
                <span>View Skill Gaps</span>
            </a>
            <a href="/analyze-skill-gaps" class="btn btn-primary d-inline-flex align-items-center gap-2">
                <i class="bi bi-magic"></i>
                <span>Analyze Another Role</span>
            </a>
        </div>
    </div>

    <% if (!results || results.length === 0) { %>
        <!-- Empty State: When no questionnaire has been taken -->
        <div class="card border-0 shadow-sm text-center p-5 my-4">
            <div class="card-body py-5">
                <div class="stat-icon saffron mx-auto mb-3" style="width: 64px; height: 64px; font-size: 1.8rem;">
                    <i class="bi bi-journal-plus"></i>
                </div>
                <h3 class="fw-bold mb-2">No Curriculum Recommendations Available</h3>
                <p class="text-muted mx-auto mb-4" style="max-width: 550px;">
                    Take our 10-question skill gap assessment to identify your missing skills and generate tailored learning recommendations aligned with current hiring needs.
                </p>
                <a href="/analyze-skill-gaps" class="btn btn-primary btn-lg px-5 py-3 fw-bold shadow-sm">
                    <i class="bi bi-magic me-2"></i>Analyze Skill Gaps Now
                </a>
            </div>
        </div>
    <% } else { %>

        <% results.forEach(result => { %>
            <div class="card shadow-sm border-0 mb-5 overflow-hidden">
                <!-- Role Header Banner -->
                <div class="card-header bg-white border-bottom p-4">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1">
                                    <i class="bi bi-check2-circle me-1"></i> Analysis-Driven Recommendations
                                </span>
                                <span class="badge bg-secondary-subtle text-secondary border px-3 py-1">
                                    <%= result.data.sector %>
                                </span>
                            </div>
                            <h2 class="fw-bold mb-1"><%= result.data.course %></h2>
                            <p class="text-muted mb-0 small">
                                <i class="bi bi-geo-alt me-1"></i>Target Benchmark: <%= result.data.district %>
                            </p>
                        </div>
                        <div>
                            <span class="badge bg-primary fs-6 px-3 py-2">
                                <i class="bi bi-lightbulb me-1"></i> <%= result.recommendations.length %> Actionable <%= result.recommendations.length === 1 ? 'Update' : 'Updates' %>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <% if (result.recommendations.length === 0) { %>
                        <div class="alert alert-success d-flex align-items-center p-4 rounded-3 shadow-sm border-0 mb-0" role="alert">
                            <i class="bi bi-check-circle-fill fs-2 me-3 text-success"></i>
                            <div>
                                <h5 class="alert-heading fw-bold mb-1">No Curriculum Updates Required!</h5>
                                <p class="mb-0">
                                    Based on your questionnaire responses, you possess all required high-demand competencies for <strong><%= result.data.course %></strong>. No urgent curriculum interventions are necessary.
                                </p>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="row g-4">
                            <% result.recommendations.forEach((rec, idx) => { %>
                                <div class="col-12">
                                    <div class="card border rounded-3 shadow-sm p-4" style="border-left: 4px solid <%= rec.priority === 'High' ? 'var(--si-danger, #ef4444)' : (rec.priority === 'Medium' ? 'var(--si-saffron, #f59e0b)' : 'var(--si-primary, #1e3a8a)') %> !important;">
                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-dark text-white rounded-pill px-3 py-1">#<%= idx + 1 %></span>
                                                <h4 class="mb-0 fw-bold text-dark"><%= rec.skill %></h4>
                                            </div>
                                            <div>
                                                <% if (rec.priority === "High") { %>
                                                    <span class="badge bg-danger px-3 py-2">High Priority</span>
                                                <% } else if (rec.priority === "Medium") { %>
                                                    <span class="badge bg-warning text-dark px-3 py-2">Medium Priority</span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary px-3 py-2">Low Priority</span>
                                                <% } %>
                                            </div>
                                        </div>

                                        <div class="row align-items-center mb-3 g-2">
                                            <div class="col-sm-3 text-muted small fw-semibold">
                                                Industry Hiring Demand:
                                            </div>
                                            <div class="col-sm-9">
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="progress flex-grow-1" style="height: 10px;">
                                                        <div class="progress-bar <%= rec.priority === 'High' ? 'bg-danger' : (rec.priority === 'Medium' ? 'bg-warning' : 'bg-primary') %>" 
                                                             role="progressbar" 
                                                             style="width: <%= rec.demand %>%" 
                                                             aria-valuenow="<%= rec.demand %>" 
                                                             aria-valuemin="0" 
                                                             aria-valuemax="100">
                                                        </div>
                                                    </div>
                                                    <strong class="text-dark"><%= rec.demand %>%</strong>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="bg-light p-3 rounded-3 border">
                                            <div class="d-flex align-items-start gap-2">
                                                <i class="bi bi-lightbulb-fill text-warning fs-5 mt-1"></i>
                                                <div>
                                                    <strong class="text-dark d-block mb-1">Curriculum & Action Recommendation:</strong>
                                                    <p class="mb-0 text-secondary" style="line-height: 1.6;">
                                                        <%= rec.recommendation %>
                                                    </p>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } %>
                </div>
            </div>
        <% }); %>

    <% } %>

</div>