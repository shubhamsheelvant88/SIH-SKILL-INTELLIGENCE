<% layout('layouts/boilerplate') %>

<div class="container-fluid px-0">

    <!-- ===== HEADER ===== -->
    <div class="page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="mb-1"><i class="bi bi-person-badge"></i> Role-wise Industry Demand</h1>
            <p class="mb-0">Distribution of job demand across different roles</p>
        </div>
        <span class="skill-chip"><i class="bi bi-briefcase"></i> <%= totalJobs %> postings analysed</span>
    </div>

    <%
    const sortedRoles = Object.entries(roleDemand).sort((a, b) => b[1] - a[1]);
    const topRole = sortedRoles.length > 0 ? sortedRoles[0] : null;
    %>

    <% if (sortedRoles.length === 0) { %>

        <!-- ===== EMPTY STATE ===== -->
        <div class="card">
            <div class="card-body text-center py-5">
                <div class="stat-icon blue mx-auto mb-3" style="width:64px;height:64px;font-size:1.8rem;"><i class="bi bi-inbox"></i></div>
                <h5 class="mb-2">No Role Data Available</h5>
                <p class="text-muted mb-4">Add job postings to start computing role-wise industry demand.</p>
                <a href="/job-posting" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Add Job Posting</a>
            </div>
        </div>

    <% } else { %>

        <!-- ===== KPI STRIP ===== -->
        <div class="row g-4 mb-4">
            <div class="col-sm-6 col-xl-4">
                <div class="stat-card">
                    <div class="stat-icon blue"><i class="bi bi-briefcase"></i></div>
                    <div class="stat-label">Total Job Postings</div>
                    <div class="stat-value"><%= totalJobs %></div>
                    <div class="stat-trend text-muted">Analysed for roles</div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-4">
                <div class="stat-card">
                    <div class="stat-icon saffron"><i class="bi bi-collection"></i></div>
                    <div class="stat-label">Distinct Roles</div>
                    <div class="stat-value"><%= sortedRoles.length %></div>
                    <div class="stat-trend text-muted">Detected in postings</div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-4">
                <div class="stat-card">
                    <div class="stat-icon green"><i class="bi bi-trophy"></i></div>
                    <div class="stat-label">Top Role</div>
                    <div class="stat-value" style="font-size:1.25rem; line-height:1.3;"><%= topRole[0] %></div>
                    <div class="stat-trend text-muted"><%= topRole[1] %>% of all postings</div>
                </div>
            </div>
        </div>
<!-- ===== CHART + RANKED LIST ===== -->
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="dashboard-section-title"><i class="bi bi-bar-chart"></i> Role Demand Distribution</div>
                        <div class="chart-container" style="height:320px;">
                            <canvas id="roleDemandChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="dashboard-section-title"><i class="bi bi-list-ol"></i> Role Ranking</div>
                        <% sortedRoles.forEach((item, index) => { %>
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <span class="rank-badge"><%= index + 1 %></span>
                                <% if (index === 0) { %><i class="bi bi-crown text-saffron" title="Highest demand"></i><% } %>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-semibold"><%= item[0] %></span>
                                        <span class="fw-bold text-primary"><%= item[1] %>%</span>
                                    </div>
                                    <div class="progress">
                                        <div class="progress-bar <% if (index === 0) { %>bg-warning<% } %>" role="progressbar" style="width: <%= item[1] %>%"></div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        </div>

    <% } %>

</div>
<!-- ===== CHART SCRIPT ===== -->
<% if (Object.keys(roleDemand).length > 0) { %>
<script>
    (function () {
        if (typeof Chart === 'undefined') return;
        var roleData = <%- JSON.stringify(roleDemand) %>;
        var entries = Object.entries(roleData).sort(function (a, b) { return b[1] - a[1]; });
        var canvas = document.getElementById('roleDemandChart');
        if (!canvas) return;
        new Chart(canvas, {
            type: 'bar',
            data: {
                labels: entries.map(function (e) { return e[0]; }),
                datasets: [{
                    label: 'Demand (%)',
                    data: entries.map(function (e) { return e[1]; }),
                    backgroundColor: entries.map(function (e, i) {
                        return i === 0 ? 'rgba(245, 158, 11, 0.85)' : 'rgba(30, 58, 138, 0.75)';
                    }),
                    borderColor: entries.map(function (e, i) {
                        return i === 0 ? '#d97706' : '#1e3a8a';
                    }),
                    borderWidth: 1,
                    borderRadius: 6,
                    maxBarThickness: 46
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: function (context) { return ' Demand: ' + context.parsed.x + '%'; } } }
                },
                scales: {
                    x: {
                        beginAtZero: true,
                        max: 100,
                        grid: { color: 'rgba(226,232,240,0.6)' },
                        ticks: { callback: function (value) { return value + '%'; } }
                    },
                    y: { grid: { display: false } }
                }
            }
        });
    })();
</script>
<% } %>