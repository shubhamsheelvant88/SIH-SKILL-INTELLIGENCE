<% layout('layouts/boilerplate') %>

<div class="container py-5">
  <!-- Hero Card -->
  <div class="card border-0 shadow-sm rounded-4 p-5 bg-white text-center mx-auto" style="max-width: 950px;">
    <div class="card-body py-4">
      
      <!-- Top Pill Badge -->
      <span class="badge bg-primary px-3 py-2 rounded-pill mb-4 font-monospace fw-semibold" style="font-size: 0.85rem;">
        AI & Labour Market Intelligence
      </span>

      <!-- Main Title -->
      <h1 class="display-4 fw-bold text-dark mb-3">
        Skill Intelligence Platform
      </h1>

      <!-- Subtitle Paragraph -->
      <p class="lead text-secondary mx-auto mb-4" style="max-width: 680px; font-size: 1.1rem; line-height: 1.6;">
        From Industry Demand <span class="text-muted">→</span> To Actionable Curriculum Updates & Better Training Outcomes. 
        Harmonizing job postings, employer validations, and district-level execution.
      </p>

      <!-- Action Buttons -->
      <div class="d-flex justify-content-center gap-3">
        <a href="/dashboard" class="btn btn-primary btn-lg px-4 py-2 rounded-3 shadow-sm font-semibold">
          Open Dashboard
        </a>
        <a href="/live-analysis" class="btn btn-outline-secondary btn-lg px-4 py-2 rounded-3 font-semibold">
          Live Market Analysis
        </a>
      </div>

    </div>
  </div>

  <!-- Cards Section Grid below Hero -->
  <div class="row g-4 mt-4 justify-content-center" style="max-width: 950px; margin: 0 auto;">
    <div class="col-md-4">
      <div class="card border-0 shadow-sm rounded-4 h-100 p-3 text-center">
        <div class="card-body">
          <div class="fs-1 mb-2">📊</div>
          <h5 class="fw-bold">Demand Analysis</h5>
          <p class="text-muted small">Track real-time hiring trends and skill demands in industry.</p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm rounded-4 h-100 p-3 text-center">
        <div class="card-body">
          <div class="fs-1 mb-2">🏢</div>
          <h5 class="fw-bold">Employer Sync</h5>
          <p class="text-muted small">Validate curriculum updates directly with industry partners.</p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm rounded-4 h-100 p-3 text-center">
        <div class="card-body">
          <div class="fs-1 mb-2">🗺️</div>
          <h5 class="fw-bold">District Planning</h5>
          <p class="text-muted small">Drive ground-level skill development and placement outcomes.</p>
        </div>
      </div>
    </div>
  </div>
</div>