<% layout('layouts/boilerplate') %>

<div class="container py-5">
  <div class="p-5 mb-5 bg-light rounded-4 shadow-sm text-center border">
    <span class="badge bg-primary px-3 py-2 fs-6 mb-3">AI & Labour Market Intelligence</span>
    <h1 class="display-4 fw-bold">Skill Intelligence Platform</h1>
    <p class="col-md-8 mx-auto lead text-muted mt-3">
      From Industry Demand &rarr; To Actionable Curriculum Updates & Better Training Outcomes.
      Harmonizing job postings, employer validations, and district-level execution.
    </p>
    <div class="d-flex justify-content-center gap-3 mt-4">
      <a href="/dashboard" class="btn btn-primary btn-lg px-4">
        Open Dashboard
      </a>
      <a href="/live-analysis" class="btn btn-outline-dark btn-lg px-4">
        Live Market Analysis
      </a>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-md-4">
      <div class="card h-100 card-hover-elevate p-3">
        <div class="card-body">
          <div class="fs-1 mb-2">📊</div>
          <h4 class="card-title">Skill Gap Analysis</h4>
          <p class="card-text text-muted">Compare market demand with current academic curricula to pinpoint high-priority training deficits.</p>
          <a href="/skill-gap" class="btn btn-sm btn-outline-primary">Analyse Gaps &rarr;</a>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card h-100 card-hover-elevate p-3">
        <div class="card-body">
          <div class="fs-1 mb-2">🏢</div>
          <h4 class="card-title">Employer Validation</h4>
          <p class="card-text text-muted">Collect verified direct employer feedback on required proficiencies and ground curricular recommendations.</p>
          <a href="/employers" class="btn btn-sm btn-outline-primary">View Validations &rarr;</a>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card h-100 card-hover-elevate p-3">
        <div class="card-body">
          <div class="fs-1 mb-2">🗺️</div>
          <h4 class="card-title">District Training Plans</h4>
          <p class="card-text text-muted">Generate resource, trainer, and equipment allocation roadmaps tailored to local industrial demand.</p>
          <a href="/district-plan" class="btn btn-sm btn-outline-primary">Generate Plan &rarr;</a>
        </div>
      </div>
    </div>
  </div>
</div>
