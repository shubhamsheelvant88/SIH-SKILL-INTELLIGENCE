<% layout('layouts/boilerplate') %>

<div class="container mt-5" style="max-width: 760px;">
  <div class="text-center mb-5">
    <h1 class="display-5 fw-bold">Submit Job Posting</h1>
    <p class="text-muted lead">Add a real-world job posting to parse technical requirements and feed market demand</p>
  </div>

  <div class="card shadow-sm border">
    <div class="card-body p-4">
      <form action="/job-posting" method="POST">
        <div class="mb-3">
          <label class="form-label fw-bold">Company Name</label>
          <input type="text" name="company" class="form-control" placeholder="e.g. TechNova, Infosys, Amazon" required>
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold">Job Role</label>
          <input type="text" name="role" class="form-control" placeholder="e.g. Full Stack Developer, Cloud Architect" required>
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold">Location</label>
          <input type="text" name="location" class="form-control" placeholder="e.g. Bengaluru, Hyderabad, Pune" required>
        </div>

        <div class="mb-4">
          <label class="form-label fw-bold">Job Description</label>
          <textarea name="description" class="form-control" rows="8" placeholder="Paste the job description or role requirements here (e.g. React, Node.js, AWS, Docker, Python)..." required></textarea>
          <small class="text-muted">Our AI skill-extractor will parse technical competencies automatically.</small>
        </div>

        <div class="d-flex justify-content-between align-items-center">
          <a href="/job-postings" class="text-decoration-none text-muted">&larr; View Analyzed Jobs</a>
          <button type="submit" class="btn btn-primary px-4">Analyze Job Posting</button>
        </div>
      </form>
    </div>
  </div>
</div>
