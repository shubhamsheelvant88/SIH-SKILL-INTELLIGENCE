<% layout('layouts/boilerplate') %>

<div class="container mt-5" style="max-width: 760px;">
  <div class="text-center mb-5">
    <h1 class="display-5 fw-bold">Record Placement Outcome</h1>
    <p class="text-muted lead">Track batch training completion, employment conversion, and salary metrics</p>
  </div>

  <div class="card shadow-sm border">
    <div class="card-body p-4">
      <form action="/placement-outcome" method="POST">
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">District</label>
            <input type="text" name="district" class="form-control" placeholder="e.g. Bengaluru, Mysuru" required>
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Course Name</label>
            <input type="text" name="course" class="form-control" placeholder="e.g. Full Stack Development" required>
          </div>
        </div>

        <div class="row">
          <div class="col-md-4 mb-3">
            <label class="form-label fw-bold">Students Trained</label>
            <input type="number" name="studentsTrained" class="form-control" min="0" placeholder="e.g. 60" required>
          </div>

          <div class="col-md-4 mb-3">
            <label class="form-label fw-bold">Students Completed</label>
            <input type="number" name="studentsCompleted" class="form-control" min="0" placeholder="e.g. 55" required>
          </div>

          <div class="col-md-4 mb-3">
            <label class="form-label fw-bold">Students Placed</label>
            <input type="number" name="studentsPlaced" class="form-control" min="0" placeholder="e.g. 48" required>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Average Salary (₹ / annum)</label>
            <input type="number" name="averageSalary" class="form-control" min="0" placeholder="e.g. 450000">
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Employer Satisfaction (1 to 5)</label>
            <input type="number" name="employerSatisfaction" min="1" max="5" class="form-control" placeholder="Rating 1-5">
          </div>
        </div>

        <div class="mb-4">
          <label class="form-label fw-bold">Skills Used in Jobs</label>
          <input type="text" name="skillsUsed" class="form-control" placeholder="e.g. React, Node.js, AWS, MongoDB">
          <small class="text-muted">Comma-separated list of technical skills utilized by placed candidates.</small>
        </div>

        <div class="d-flex justify-content-between align-items-center">
          <a href="/placement-outcomes" class="text-decoration-none text-muted">&larr; View Placement Records</a>
          <button type="submit" class="btn btn-primary px-4">Submit Placement Outcome</button>
        </div>
      </form>
    </div>
  </div>
</div>
