<% layout('layouts/boilerplate') %>

<div class="container mt-5">
  <div class="text-center mb-5">
    <h1 class="display-5 fw-bold">Skill Gap Analysis</h1>
    <p class="text-muted lead">Comparing industry market requirements with current course curricula</p>
  </div>

  <% if (!results || results.length === 0) { %>
    <div class="alert alert-info text-center p-4">
      <h4>No Curriculum Data Available</h4>
      <p>Please seed or initialize curriculum data to generate gap analysis.</p>
    </div>
  <% } else { %>
    <% results.forEach(result => { %>
      <div class="card shadow-sm mb-5">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <h3 class="fw-bold mb-1"><%= result.data.course %></h3>
              <p class="text-muted mb-0"><%= result.data.district %> &bull; <%= result.data.sector %></p>
            </div>
            <a href="/recommendations" class="btn btn-sm btn-outline-success">View Recommendations &rarr;</a>
          </div>

          <h4 class="mt-4 mb-3 text-secondary">Detected Missing Skills in Curriculum</h4>

          <% if (!result.gaps || result.gaps.length === 0) { %>
            <div class="alert alert-success mt-3">
              🎉 No major skill gaps detected! The current curriculum covers all top industry demand areas.
            </div>
          <% } else { %>
            <div class="row">
              <% result.gaps.forEach(gap => { %>
                <div class="col-md-6 mb-3">
                  <div class="card border h-100 p-2">
                    <div class="card-body">
                      <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="card-title fw-bold mb-0"><%= gap.skill %></h5>
                        <% if (gap.priority === "High") { %>
                          <span class="badge bg-danger">High Priority</span>
                        <% } else if (gap.priority === "Medium") { %>
                          <span class="badge bg-warning text-dark">Medium Priority</span>
                        <% } else { %>
                          <span class="badge bg-secondary">Low Priority</span>
                        <% } %>
                      </div>

                      <p class="mt-3 mb-2 text-muted">
                        Industry Demand: <strong><%= gap.demand %>%</strong>
                      </p>

                      <div class="progress">
                        <div
                          class="progress-bar <%= gap.priority === 'High' ? 'bg-danger' : (gap.priority === 'Medium' ? 'bg-warning text-dark' : 'bg-secondary') %>"
                          role="progressbar"
                          style="width: <%= gap.demand %>%;"
                          aria-valuenow="<%= gap.demand %>"
                          aria-valuemin="0"
                          aria-valuemax="100"
                        >
                          <%= gap.demand %>%
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>
