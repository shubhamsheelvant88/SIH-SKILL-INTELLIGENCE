<% layout('layouts/boilerplate') %>

<div class="container mt-5">
  <div class="text-center mb-5">
    <h1 class="display-5 fw-bold">Validated Skill Gaps</h1>
    <p class="text-muted lead">Cross-referencing curriculum gaps against direct employer validation</p>
  </div>

  <% if (!results || results.length === 0) { %>
    <div class="alert alert-info text-center p-4">
      <h4>No Validation Data Available</h4>
      <p>Seed curriculum data and submit employer feedback to generate validated gaps.</p>
    </div>
  <% } else { %>
    <% results.forEach(result => { %>
      <div class="card shadow-sm mb-5">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <h3 class="fw-bold mb-1"><%= result.data.course %></h3>
              <p class="text-muted mb-0"><%= result.data.district %> &bull; <%= result.data.sector %></p>
            </div>
            <a href="/employers" class="btn btn-sm btn-outline-secondary">&larr; Back to Employers</a>
          </div>

          <% if (!result.validatedGaps || result.validatedGaps.length === 0) { %>
            <div class="alert alert-success mt-3">
              🎉 No skill gaps detected! The course curriculum is thoroughly validated.
            </div>
          <% } else { %>
            <% result.validatedGaps.forEach(gap => { %>
              <div class="card mb-4 border">
                <div class="card-body p-3">
                  <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold mb-0"><%= gap.skill %></h4>
                    <% if (gap.priority === "High") { %>
                      <span class="badge bg-danger">High Priority</span>
                    <% } else if (gap.priority === "Medium") { %>
                      <span class="badge bg-warning text-dark">Medium Priority</span>
                    <% } else { %>
                      <span class="badge bg-secondary">Low Priority</span>
                    <% } %>
                  </div>

                  <div class="row g-4 mt-1">
                    <div class="col-md-6">
                      <h6 class="text-muted small text-uppercase">Industry Macro Demand</h6>
                      <h3 class="fw-bold text-primary mb-2"><%= gap.demand %>%</h3>
                      <div class="progress">
                        <div class="progress-bar bg-primary" style="width: <%= gap.demand %>%;" role="progressbar">
                          <%= gap.demand %>%
                        </div>
                      </div>
                    </div>

                    <div class="col-md-6">
                      <h6 class="text-muted small text-uppercase">Direct Employer Validation</h6>
                      <h3 class="fw-bold text-success mb-2"><%= gap.validationPercentage %>%</h3>
                      <div class="progress mb-2">
                        <div class="progress-bar bg-success" style="width: <%= gap.validationPercentage %>%;" role="progressbar">
                          <%= gap.validationPercentage %>%
                        </div>
                      </div>
                      <small class="text-muted">
                        Validated by <strong><%= gap.validatedBy %></strong> of <strong><%= gap.totalEmployers %></strong> participating employers
                      </small>
                    </div>
                  </div>

                  <div class="alert alert-light border mt-4 mb-0">
                    <strong class="text-dark">Platform Intelligence Insight:</strong>
                    <p class="mb-0 mt-1 text-muted">
                      <code><%= gap.skill %></code> is explicitly demanded by <strong><%= gap.validationPercentage %>%</strong> of surveyed industry employers and registers a macro market demand of <strong><%= gap.demand %>%</strong>. Immediate curriculum integration is advised.
                    </p>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>
